// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model Location {
  id              String            @id @default(uuid())
  name            String            @unique
  isDisabled      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  LocationDiagram LocationDiagram[]
}

model SubLocation {
  id              String            @id @default(uuid())
  name            String            @unique
  isDisabled      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  Pins            Pins[]
  LocationDiagram LocationDiagram[]
}

model Equipment {
  id         String   @id @default(uuid())
  name       String   @unique
  isDisabled Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Pins       Pins[]
}

model Objects {
  id         String   @id @default(uuid())
  name       String   @unique
  isDisabled Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Pins       Pins[]
}

model Compartment {
  id         String   @id @default(uuid())
  name       String   @unique
  isDisabled Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Pins       Pins[]
}

model DocumentType {
  id                String              @id @default(uuid())
  name              String              @unique
  isDisabled        Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  Vessel            Vessel[]
  VesselAttachments VesselAttachments[]
  PinAttachments    PinAttachments[]
}

model Inventory {
  id         String   @id @default(uuid())
  name       String   @unique
  isDisabled Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Pins       Pins[]
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  name            String?
  password        String
  roles           Role
  disabled        Boolean           @default(false)
  sessionsCount   Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tokens          UserToken[]
  loginLogs       LoginLog[]
  Vessel          Vessel[]
  Pins            Pins[]
  LocationDiagram LocationDiagram[]
}

model UserToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  disabled  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoginLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String
  createdAt DateTime @default(now())
}

model ClientManager {
  id             Int      @id @default(autoincrement())
  companyName    String
  address        String?
  contactDetails String?
  verifaviaId    String
  isClient       Boolean  @default(true) // true for Client, false for Manager
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  Vessel         Vessel[]
}

model Vessel {
  id                     String              @id @default(uuid())
  vesselName             String
  imoNumber              String              @unique
  vesselType             String
  flag                   String
  classSociety           String
  portOfRegistry         String
  grossTonnageMT         Int
  lbd                    String // L*B*D
  registeredOwner        String
  registeredOwnerAddress String
  vesselManager          String
  clientName             String
  deliveryDate           DateTime
  keelLaidDate           DateTime
  shipYardName           String
  shipYardAddress        String
  ihmClass               String
  ihmSurveyStartDate     DateTime
  ihmSurveyEndDate       DateTime
  socIssueDate           DateTime
  readyForMaintenance    Boolean             @default(false)
  maintenanceStartDate   DateTime
  vesselEmailId          String
  headerFreeTextCaption  String?
  headerFreeTextValue    String?
  poDataGapDisclaimer    String?
  commonReferenceNo      String?
  documentTypeId         String?
  documentType           DocumentType?       @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  clientId               Int?
  clientManager          ClientManager?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy              String?
  user                   User?               @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  VesselAttachments      VesselAttachments[]
  VesselImages           VesselImages[]
  LocationDiagram        LocationDiagram[]
}

model VesselAttachments {
  id               String             @id @default(uuid())
  fileName         String
  url              String
  documentTypeId   String
  documentType     DocumentType       @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  vesselId         String
  vessel           Vessel             @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  AttachmentImages AttachmentImages[]
}

model VesselImages {
  id        String   @id @default(uuid())
  fileName  String
  url       String
  vesselId  String
  vessel    Vessel   @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AttachmentImages {
  id              String            @id @default(uuid())
  fileName        String
  url             String
  attachmentId    String
  attachment      VesselAttachments @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  LocationDiagram LocationDiagram[]
}

model LocationDiagram {
  id                   String                 @id @default(uuid())
  vesselId             String
  vessel               Vessel                 @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  attachmentImageId    String
  AttachmentImage      AttachmentImages       @relation(fields: [attachmentImageId], references: [id], onDelete: Cascade)
  locationId           String
  location             Location               @relation(fields: [locationId], references: [id], onDelete: Cascade)
  subLocationId        String
  subLocation          SubLocation            @relation(fields: [subLocationId], references: [id], onDelete: Cascade)
  userId               String?
  user                 User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  LocationDiagramImage LocationDiagramImage[]
  Pins                 Pins[]
}

model LocationDiagramImage {
  id                String          @id @default(uuid())
  fileName          String
  url               String
  locationDiagramId String
  locationDiagram   LocationDiagram @relation(fields: [locationDiagramId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Pins {
  id                String           @id @default(uuid())
  x                 Float
  y                 Float
  locationDiagramId String
  locationDiagram   LocationDiagram  @relation(fields: [locationDiagramId], references: [id], onDelete: Cascade)
  subLocationId     String
  subLocation       SubLocation      @relation(fields: [subLocationId], references: [id], onDelete: Cascade)
  equipmentId       String
  equipment         Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  compartmentId     String
  compartment       Compartment      @relation(fields: [compartmentId], references: [id], onDelete: Cascade)
  ObjectId          String
  object            Objects          @relation(fields: [ObjectId], references: [id], onDelete: Cascade)
  inventoryId       String
  inventory         Inventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  Description       String
  isPCHM            Boolean          @default(false)
  manufacturerBrand String
  referenceNo       String
  remarks           String
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  PinAttachments    PinAttachments[]
  PinImages         PinImages[]
}

model PinAttachments {
  id             String       @id @default(uuid())
  fileName       String
  url            String
  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  pinId          String
  pin            Pins         @relation(fields: [pinId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model PinImages {
  id        String   @id @default(uuid())
  fileName  String
  url       String
  pinId     String
  pin       Pins     @relation(fields: [pinId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubLocations {
  id                  String   @id @default(uuid())
  subLocationName     String
  status              Boolean  @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Compartments {
  id                  String   @id @default(uuid())
  compartmentName     String
  status              Boolean  @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Equipments {
  id                  String   @id @default(uuid())
  equipmentName       String
  status              Boolean  @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
