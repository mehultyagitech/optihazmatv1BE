// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model Location {
  id              String            @id @default(uuid())
  name            String            @unique
  isDisabled      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  LocationDiagram LocationDiagram[]
}

model Hazmat {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  isDisabled Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  PinHazmat  PinHazmat[]
}

model Unit {
  id         String      @id @default(uuid())
  name       String      @unique
  isDisabled Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  PinHazmat  PinHazmat[]
}

model ResultType {
  id         String      @id @default(uuid())
  name       String      @unique
  isDisabled Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  PinHazmat  PinHazmat[]
}

model SubLocation {
  id              String            @id @default(uuid())
  name            String            @unique
  isDisabled      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  Pins            Pins[]
  LocationDiagram LocationDiagram[]
}

model Equipment {
  id         String   @id @default(uuid())
  name       String   @unique
  isDisabled Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Pins       Pins[]
}

model Objects {
  id         String   @id @default(uuid())
  name       String   @unique
  isDisabled Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Pins       Pins[]
}

model Compartment {
  id         String   @id @default(uuid())
  name       String   @unique
  isDisabled Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Pins       Pins[]
}

model DocumentType {
  id                String              @id @default(uuid())
  name              String              @unique
  isDisabled        Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  Vessel            Vessel[]
  VesselAttachments VesselAttachments[]
  PinAttachments    PinAttachments[]
}

model Inventory {
  id         String   @id @default(uuid())
  name       String   @unique
  isDisabled Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Pins       Pins[]
}

model PinHazmat {
  id            Int        @id @default(autoincrement())
  totalMass     Float      @default(0)
  hazInventMass Float      @default(0)
  remarks       String?
  hazmatId      Int
  hazmat        Hazmat     @relation(fields: [hazmatId], references: [id], onDelete: Cascade)
  unitId        String
  unit          Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  resultTypeId  String
  resultType    ResultType @relation(fields: [resultTypeId], references: [id], onDelete: Cascade)
  pinId         String
  pin           Pins       @relation(fields: [pinId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  name            String?
  password        String
  roles           Role
  disabled        Boolean           @default(false)
  sessionsCount   Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tokens          UserToken[]
  loginLogs       LoginLog[]
  Vessel          Vessel[]
  Pins            Pins[]
  LocationDiagram LocationDiagram[]
}

model UserToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  disabled  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoginLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String
  createdAt DateTime @default(now())
}

model ClientManager {
  id             Int             @id @default(autoincrement())
  companyName    String
  address        String?
  contactDetails String?
  verifaviaId    String
  isClient       Boolean         @default(true) // true for Client, false for Manager
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  ClientVessels  Vessel[]        @relation("Client")
  ManagedVessels Vessel[]        @relation("Manager")
  VesselHistory  VesselHistory[]
}

model Vessel {
  id                     String                 @id @default(uuid())
  vesselName             String
  imoNumber              String                 @unique
  vesselType             String
  flag                   String
  classSociety           String
  portOfRegistry         String
  grossTonnageMT         Int
  lbd                    String // L*B*D
  registeredOwner        String
  registeredOwnerAddress String
  clientName             Int
  vesselManager          Int
  deliveryDate           DateTime
  keelLaidDate           DateTime
  shipYardName           String
  shipYardAddress        String
  ihmClass               String
  ihmSurveyStartDate     DateTime
  ihmSurveyEndDate       DateTime
  socIssueDate           DateTime?
  readyForMaintenance    Boolean                @default(false)
  maintenanceStartDate   DateTime
  discontinued           Boolean                @default(false)
  callSign               String?
  vesselEmailId          String?
  headerFreeTextCaption  String?
  headerFreeTextValue    String?
  poDataGapDisclaimer    String?
  commonReferenceNo      String?
  documentTypeId         String?
  documentType           DocumentType?          @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  createdBy              String?
  user                   User?                  @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  VesselAttachments      VesselAttachments[]
  VesselImages           VesselImages[]
  LocationDiagram        LocationDiagram[]
  Client                 ClientManager          @relation("Client", fields: [clientName], references: [id], onDelete: Cascade)
  Manager                ClientManager          @relation("Manager", fields: [vesselManager], references: [id], onDelete: Cascade)
  VesselHistory          VesselHistory[]
  VesselInventoryImage   VesselInventoryImage[]
  PurchaseOrders         PurchaseOrder[]
  IHMReports             IHMReport[]
}

model VesselInventoryImage {
  id        String   @id @default(uuid())
  fileName  String
  url       String
  isMain    Boolean  @default(false)
  vesselId  String
  vessel    Vessel   @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VesselHistory {
  id                  String        @id @default(uuid())
  entryDate           DateTime      @default(now())
  activeDate          DateTime?     @default(now())
  discontinuedDate    DateTime?
  activeRemarks       String?
  discontinuedRemarks String?
  clientName          Int
  client              ClientManager @relation(fields: [clientName], references: [id], onDelete: Cascade)
  vesselId            String
  vessel              Vessel        @relation(fields: [vesselId], references: [id], onDelete: Cascade)
}

model VesselAttachments {
  id               String             @id @default(uuid())
  fileName         String
  url              String
  documentTypeId   String
  documentType     DocumentType       @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  vesselId         String
  vessel           Vessel             @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  AttachmentImages AttachmentImages[]
}

model VesselImages {
  id        String   @id @default(uuid())
  fileName  String
  url       String
  vesselId  String
  vessel    Vessel   @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AttachmentImages {
  id              String            @id @default(uuid())
  fileName        String
  url             String
  attachmentId    String
  attachment      VesselAttachments @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  LocationDiagram LocationDiagram[]
}

model LocationDiagram {
  id                   String                 @id @default(uuid())
  vesselId             String
  vessel               Vessel                 @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  attachmentImageId    String
  AttachmentImage      AttachmentImages       @relation(fields: [attachmentImageId], references: [id], onDelete: Cascade)
  locationId           String
  location             Location               @relation(fields: [locationId], references: [id], onDelete: Cascade)
  subLocationId        String
  subLocation          SubLocation            @relation(fields: [subLocationId], references: [id], onDelete: Cascade)
  userId               String?
  user                 User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  LocationDiagramImage LocationDiagramImage[]
  Pins                 Pins[]
}

model LocationDiagramImage {
  id                String          @id @default(uuid())
  fileName          String
  url               String
  locationDiagramId String
  locationDiagram   LocationDiagram @relation(fields: [locationDiagramId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Pins {
  id                      String                    @id @default(uuid())
  x                       Float
  y                       Float
  locationDiagramId       String
  locationDiagram         LocationDiagram           @relation(fields: [locationDiagramId], references: [id], onDelete: Cascade)
  subLocationId           String
  subLocation             SubLocation               @relation(fields: [subLocationId], references: [id], onDelete: Cascade)
  equipmentId             String
  equipment               Equipment                 @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  compartmentId           String
  compartment             Compartment               @relation(fields: [compartmentId], references: [id], onDelete: Cascade)
  ObjectId                String
  object                  Objects                   @relation(fields: [ObjectId], references: [id], onDelete: Cascade)
  inventoryId             String
  inventory               Inventory                 @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  Description             String
  isPCHM                  Boolean                   @default(false)
  manufacturerBrand       String
  referenceNo             String
  remarks                 String
  isRemovedFromIHM        Boolean                   @default(false)
  isReplaced              Boolean                   @default(false)
  removedDate             DateTime?
  removedRemarks          String?
  installationDate        DateTime?
  useCommonImage          Boolean                   @default(false)
  saveWithoutImage        Boolean                   @default(false)
  userId                  String
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  PinAttachments          PinAttachments[]
  PinImages               PinImages[]
  PinAttachmentPivotLinks PinAttachmentPivotLinks[]
  PinHazmat               PinHazmat[]
}

model PinAttachments {
  id                      String                    @id @default(uuid())
  fileName                String
  url                     String
  documentTypeId          String
  documentType            DocumentType              @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  pinId                   String
  pin                     Pins                      @relation(fields: [pinId], references: [id], onDelete: Cascade)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  PinAttachmentPivotLinks PinAttachmentPivotLinks[]
}

model PinAttachmentPivotLinks {
  id           Int            @id @default(autoincrement())
  pinId        String
  pin          Pins           @relation(fields: [pinId], references: [id], onDelete: Cascade)
  attachmentId String
  attachment   PinAttachments @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
}

model PinImages {
  id        String   @id @default(uuid())
  fileName  String
  url       String
  pinId     String
  pin       Pins     @relation(fields: [pinId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubLocations {
  id              String   @id @default(uuid())
  subLocationName String
  status          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Compartments {
  id              String   @id @default(uuid())
  compartmentName String
  status          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Equipments {
  id            String   @id @default(uuid())
  equipmentName String
  status        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---- Purchase Orders (uploaded from the PO Excel; one PO has many items) ----

model PurchaseOrder {
  id              String    @id @default(uuid())
  poNumber        String
  shipName        String?
  shipImo         String?
  clientName      String?
  supplier        String?
  supplierEmail1  String?
  supplierEmail2  String?
  supplierEmail3  String?
  supplierPhone1  String?
  supplierPhone2  String?
  orderDate       String?
  orderRcvDate    String?
  referenceNumber String?
  emailType       String?
  currencyCode    String?
  docStatus       String    @default("not_started")
  vesselId        String?
  vessel          Vessel?   @relation(fields: [vesselId], references: [id], onDelete: SetNull)
  items           PoItem[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([shipImo])
  @@index([poNumber])
}

model PoItem {
  id               String        @id @default(uuid())
  poId             String
  po               PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product          String?
  brand            String?
  partDescription  String?
  partExecution    String?
  qtyRcv           String?
  unit             String?
  remarks          String?
  itemDiscountPer  String?
  priceUnit        String?
  canContainHazmat String?       @default("NO")
  createdAt        DateTime      @default(now())
}

// ---- Generated IHM Reports (history list on the Generate IHM page) ----

model IHMReport {
  id              String    @id @default(uuid())
  vesselId        String
  vessel          Vessel    @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  version         String
  periodToDate    DateTime?
  ihmReportNumber String?
  fileName        String?
  fileUrl         String?
  approved        Boolean   @default(false)
  disabled        Boolean   @default(false)
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([vesselId])
}
